# Docker Compose / 部署环境变量示例。复制为 .env 并填入真实值，.env 不要提交 Git。

# 数据库
MYSQL_ROOT_PASSWORD=root123
MYSQL_PASSWORD=lingtu123

# JWT 密钥（生产环境请换成足够长的随机字符串）
JWT_SECRET=please-change-to-a-long-random-string

# LLM 审核服务（OpenAI 兼容接口）
LLM_API_KEY=sk-your-llm-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 初始管理员账号（用于测试 Resource B）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345

# 允许跨域的前端来源
CORS_ORIGINS=http://localhost
